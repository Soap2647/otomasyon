# Telegram bot on the UNO Q (kahya), as a user service. Needs: sudo loginctl enable-linger arduino
#   cp kurulum/kahya/otomasyon-bot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now otomasyon-bot
#   journalctl --user -u otomasyon-bot -f
[Unit]
Description=Otomasyon Telegram botu (kahya)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/otomasyon
# claude CLI and uv live in ~/.local/bin
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/otomasyon/.venv/bin/python -m otomasyon.bot
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
