# .env.example -> .env olarak kopyala ve doldur. .env ASLA commitlenmez.
# Google Cloud "otomasyon" projesi, OAuth istemcisi (Masaustu uygulamasi): rclone + Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Takvim > Ayarlar > takvim > Takvimi entegre et > iCal bicimindeki gizli adres
TAKVIM_ICAL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Gmail uygulama sifreleri (config.toml'daki etiketlere gore)
GMAIL_MAIN=
GMAIL_SECOND=
